{
  "name": "desktop", "productName": "ShikkhaOS", "version": "0.1.0", "private": true, "description": "ShikkhaOS desktop application for school staff",
  "author": "ShikkhaOS", "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-main.mjs",
    "dist:win": "pnpm build && electron-builder --win --publish never --config electron-builder.config.cjs",
    "dist:dir": "pnpm build && electron-builder --dir --config electron-builder.config.cjs",
    "typecheck": "tsc -p tsconfig.json", "lint": "tsc -p tsconfig.json", "test": "vitest run"
  },
  "dependencies": { "electron-updater": "^6.3.9" },
  "devDependencies": {
    "@shikkhaos/api-client": "workspace:*", "@shikkhaos/screens": "workspace:*", "@shikkhaos/types": "workspace:*",
    "@types/node": "^22.10.0", "@types/react": "^18.3.12", "@types/react-dom": "^18.3.1", "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1", "electron-builder": "^25.1.8", "esbuild": "^0.24.2", "react": "^18.3.1", "react-dom": "^18.3.1", "typescript": "~5.7.3", "vite": "^5.4.11", "vitest": "^2.1.8"
  }
}
