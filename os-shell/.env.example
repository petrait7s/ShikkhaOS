NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_DEMO_MODE=true

# Only used when NEXT_PUBLIC_API_MODE=http
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
