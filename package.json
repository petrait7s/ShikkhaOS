{
  "name": "shikkhaos",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @shikkhaos/e2e test",
    "contract:check": "node scripts/contract-check.mjs",
    "build": "pnpm -r --if-present build",
    "web:build": "pnpm --filter web build",
    "web:dev": "pnpm --filter web dev",
    "web:start": "pnpm --filter web start",
    "desktop:dev": "pnpm --filter desktop dev",
    "desktop:build": "pnpm --filter desktop build",
    "desktop:dist:win": "pnpm --filter desktop dist:win",
    "mobile:start": "pnpm --filter mobile start",
    "mobile:android": "pnpm --filter mobile android",
    "dev:web": "pnpm --filter web dev",
    "dev:desktop": "pnpm --filter desktop dev",
    "dev:mobile": "pnpm --filter mobile start"
  },
  "devDependencies": {
    "typescript": "~5.7.3",
    "@types/node": "^22.10.0"
  }
}